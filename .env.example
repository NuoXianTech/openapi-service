# Required. Generate an independent value with 32 to 4096 random characters.
API_SERVICE_TOKEN=
# Optional during online rotation only. Remove after every Platform has
# promoted API_SERVICE_TOKEN and all Targets use the new value.
API_SERVICE_PREVIOUS_TOKEN=

# Required. Independent 32-byte key (64-char hex is recommended). This key
# encrypts runtime/service-configuration.enc and must be backed up.
SERVICE_CONFIG_KEY=

# Stable Service contract identity and its Platform display name. Every Target
# in one Internal Upstream must use the same values. Do not change SERVICE_ID
# after Platform discovery or after a runtime configuration snapshot is saved.
SERVICE_ID=openapi-service
SERVICE_NAME=OpenAPI Service

# Optional source/runtime settings. Docker images already use :8080 and
# /app/data; these defaults are convenient for pnpm dev and pnpm start.
LISTEN_ADDR=:8080
SERVICE_DATA_DIR=data
