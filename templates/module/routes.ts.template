import { createRoute, type OpenAPIHono, z } from '@hono/zod-openapi'
import { createSuccessEnvelopeSchema } from '../../shared/openapi.js'
import { respondWithSuccess } from '../../shared/response.js'
import type { AppEnv } from '../../types/app.js'
import { getExample } from './service.js'

const ExampleDataSchema = z.object({
  value: z.string()
})

const exampleRoute = createRoute({
  method: 'get',
  path: '/v1/example',
  operationId: 'getExample',
  tags: ['Example'],
  security: [{ serviceToken: [] }],
  responses: {
    200: {
      content: {
        'application/json': {
          schema: createSuccessEnvelopeSchema(ExampleDataSchema)
        }
      },
      description: 'Example response'
    }
  }
})

export function registerExampleRoutes(app: OpenAPIHono<AppEnv>) {
  app.openapi(exampleRoute, async (c) => {
    return respondWithSuccess(c, await getExample())
  })
}
